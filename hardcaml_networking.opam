# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Networking hardware (Ethernet MAC, UART) written in Hardcaml"
description: """
Synthesizable networking blocks written in Hardcaml: a full-duplex 10/100 MII
Ethernet MAC, an IPv4/UDP stack over it, and a tick-driven UART pair, plus the
small common circuits (edge detectors, clock divider, heartbeat) and the Arty
A7-100T pin contract they share. Installs as hardcaml_networking.{common,mii,
ipv4,udp,uart}."""
maintainer: ["Bohdan Purtell <bohdanpurtell@gmail.com>"]
authors: ["Bohdan Purtell <bohdanpurtell@gmail.com>"]
homepage: "https://github.com/LeEmperor/hardcaml_networking"
bug-reports: "https://github.com/LeEmperor/hardcaml_networking/issues"
depends: [
  "ocaml" {>= "5.1"}
  "dune" {>= "3.17" & >= "3.17"}
  "core"
  "hardcaml"
  "hardcaml_circuits"
  "ppx_hardcaml"
  "ppx_jane"
  "hardcaml_step_testbench" {with-test}
  "hardcaml_waveterm" {with-test}
  "ppx_expect" {with-test}
  "base_quickcheck" {with-test}
  "alcotest" {with-test}
  "hardcaml_xilinx_reports" {with-test}
  "async" {with-test}
  "core_unix" {with-test}
  "jane_rope" {with-test}
  "ppx_js_style" {with-dev-setup}
  "ocamlformat" {with-dev-setup}
  "ocaml-lsp-server" {with-dev-setup}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/LeEmperor/hardcaml_networking.git"
