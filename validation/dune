; MAC validation harness — board-level scaffolding kept OUTSIDE lib/.
; Reuses Arty_board_top.I/O (hardcaml_networking) as its pin contract and drives
; Mac_top (hardcaml_networking). generate_validation.exe emits the harness RTL.

; The MAC validation harness library. Its RTL is now emitted by the unified
; generator: `dune exec bin/generate.exe -- validation`
; (the former generate_validation.exe was folded into bin/generate.ml).

(library
 (name mac_validation)
 (wrapped false)
 (libraries core hardcaml hardcaml_networking hardcaml_circuits)
 (modules
  board_scaffolding
  mac_validation_harness
  mac_validation_harness_regs
  udp_tx_validation_harness
  udp_rx_validation_harness
  udp_duplex_validation_harness
  udp_loopback_validation_harness)
 (flags
  (:standard -w -27-57-33-34-35-40-63-47-26))
 (preprocess
  (pps ppx_hardcaml ppx_jane))
 (lint
  (pps ppx_js_style)))
